{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".next-audit/next/types/**/*.ts",
    ".next-check/next/types/**/*.ts",
    ".next-dbg/types/**/*.ts",
    ".next-dbg2/types/**/*.ts",
    ".next-dbg3/types/**/*.ts",
    ".next-dev1/types/**/*.ts",
    ".next-dev5/types/**/*.ts",
    ".next-repro/types/**/*.ts",
    ".next-x/types/**/*.ts",
    ".next-y/types/**/*.ts",
    ".next-z/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    ".next-verify/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".venv",
    "research",
    "experiments",
    "scripts",
    "tests"
  ]
}
